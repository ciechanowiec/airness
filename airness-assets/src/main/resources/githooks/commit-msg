#!/usr/bin/env sh
# Checks the pending message against the same policy the whole-history gate applies, so a message that
# passes here passes CI.
#
# It delegates to the goal rather than reimplementing anything. A hook carrying its own copy of the
# rules is a second place for them to live, and the copy that drifts is the one nobody notices, because
# a hook only ever runs on the machine it drifted on.
set -eu
cd "$(git rev-parse --show-toplevel)"
mvn -q eu.ciechanowiec:airness-maven-plugin:commit-message -Dairness.commit.message.file="$1"
