#!/usr/bin/env sh
# The whole verification before anything leaves the machine, which is the same command CI runs. Nothing
# here is a subset of it: a hook that checked less than CI would be a hook that says a push is fine and
# is then contradicted, which teaches people to stop reading it.
#
# Both profiles, not just the first. -Pfull carries the gates that read the history, the network and the
# mutation analysis; -Pinspect carries the inspection scan, which is separate only because it costs
# minutes where the rest cost seconds.
set -eu
cd "$(git rev-parse --show-toplevel)"
mvn clean package -Pfull,inspect
