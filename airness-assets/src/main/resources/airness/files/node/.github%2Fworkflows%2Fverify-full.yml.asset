# Written only by airness:assets-init. This workflow belongs to the project afterwards:
# add the services and environment the application needs, or remove it for another CI platform.
name: 'Full verification'

on:
  schedule:
    - cron: '17 2 * * *'
  push:
    tags: ['v*']
  workflow_dispatch:

permissions:
  contents: read

jobs:
  verify-full:
    runs-on: ubuntu-26.04
    timeout-minutes: 360
    steps:
      - name: 'Checkout complete history'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - name: 'Set up Java'
        uses: actions/setup-java@b843ebf9b913146b38da2eaa7aeddf76074ae1ad # v6.1.0
        with:
          distribution: 'temurin'
          java-version-file: '.java-version'
          cache: 'maven'
      - name: 'Install Maven 3.10.0'
        run: |
          set -eu
          archive="$RUNNER_TEMP/apache-maven-3.10.0-bin.tar.gz"
          curl --fail --silent --show-error --location \
            'https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.10.0/apache-maven-3.10.0-bin.tar.gz' \
            --output "$archive"
          printf '%s  %s\n' \
            '908b1501bfb420bf7c8affb855534a9c407fd6099367bfb9f2f2dcb8e9799102bffb84518cde74c679bd76870247c6528683abdd620581bffa90f95d92d175aa' \
            "$archive" | sha512sum --check
          tar -xzf "$archive" -C "$RUNNER_TEMP"
          echo "$RUNNER_TEMP/apache-maven-3.10.0/bin" >> "$GITHUB_PATH"

      - name: 'Prepare the pinned browsers'
        run: |
          mvn --batch-mode airness:report-browser-install
          image='mcr.microsoft.com/playwright:v1.64.1-noble@sha256:'
          image="${image}47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea"
          docker pull "${image}"
      - name: 'Run complete Extended verification'
        run: mvn --batch-mode clean verify -Pextended
