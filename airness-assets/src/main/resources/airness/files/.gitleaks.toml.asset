# Configuration for the secret scan, which reads the whole history under the slow profile.
#
# This file is seeded once and then belongs to the project. Its rules are the scanner's own defaults,
# which are shared by construction and need nothing from the harness. What is per-project is the
# allowlist below: every project has fixtures and sample values that look like credentials, and no other
# project can say which of yours those are.
#
# Allowlist a path only when the value there is fake. A real secret must never reach a commit, and a
# path added here to quiet a finding is how one does.
title = "Secret scan configuration"

[extend]
useDefault = true

[allowlist]
description = "Fake credentials and sample patterns that exist only as fixtures or documentation"
paths = [
    '''target/.*''',
]
