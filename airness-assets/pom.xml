<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness</artifactId>
        <version>1.0.6</version>
    </parent>

    <artifactId>airness-assets</artifactId>
    <packaging>jar</packaging>

    <name>airness-assets</name>
    <description>
        The files the harness owns but cannot supply from a classpath, and the manifest saying what a
        project may do with each.

        Most of the harness reaches a project as configuration an analyzer reads off its own plugin
        classpath, which is why most of it needs no file in the project at all. What lands here is what
        something outside Maven reads from disk: an editor reading .editorconfig, git reading
        .gitattributes. Those have nowhere else to live, so they live in the project and are checked
        against the bytes shipped here.

        Each canonical file is stored under an added .asset suffix. A stored .gitignore under its own
        name would be a working .gitignore over this directory and could stop its neighbours from being
        tracked, and a stored .gitattributes would take effect over them. A file that changes the meaning
        of the directory it sits in cannot be stored under its own name.
    </description>

    <build>
        <plugins>
            <!--
                Airness answers to the dependency rules it ships. The rules themselves live in the root
                pluginManagement, so this execution names only the goal and the phase.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-enforce-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                The unused and undeclared dependency report, and the licence allowlist, both read the
                module's own resolved graph, so each module runs them for itself. The configuration is in
                the root pluginManagement, mirroring what airness-parent binds for a consumer.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-analyze-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-check-dependency-licenses</id>
                        <phase>package</phase>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Extended verification for Airness, exactly as it is for a consumer: the phase property is
                'none' by default and 'package' under the extended profile.
            -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-known-vulnerabilities</id>
                        <phase>${airness.self.vulnerabilities.phase}</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- The module has resources but no Java API, so its Central Javadoc artifact is explanatory. -->
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-placeholder-javadocs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.basedir}/src/main/javadoc</classesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
