<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
    <Match>
        <!--  Justification: https://github.com/projectlombok/lombok/wiki/WHY-NOT:-serialVersionUID  -->
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
    <Match>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
    </Match>
    <Match>
        <Bug pattern="SE_COMPARATOR_SHOULD_BE_SERIALIZABLE"/>
    </Match>
    <Match>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
    <Match>
        <!-- Disallows "toString()" in the constructor for logging purposes: -->
        <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
    </Match>
    <Match>
        <!--  It is hard to suppress this warning in false-positive situations:  -->
        <Bug pattern="NP_NULL_PARAM_DEREF_ALL_TARGETS_DANGEROUS"/>
    </Match>
    <Match>
        <!-- Gives a lot of false positives: -->
        <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
    </Match>
    <Match>
        <!--  As of writing these words this check is implemented incorrectly
              (https://github.com/spotbugs/spotbugs/issues/1797): -->
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <!--  Anon class is better anyway because its counterpart
              (static named inner class) will require inheritance  -->
        <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON"/>
    </Match>
    <Match>
        <!--  Temporarily disabled. There should have been a fix, but the fix doesn't work:
              https://github.com/spotbugs/spotbugs/issues/456
              https://github.com/spotbugs/spotbugs/pull/2709 -->
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
    <Match>
        <!--  It's ok to keep, access and update configs in servlet instance fields: -->
        <Bug pattern="MTIA_SUSPECT_SERVLET_INSTANCE_FIELD"/>
    </Match>
    <Match>
        <!--  It's ok to keep, access and update configs in servlet instance fields: -->
        <Bug pattern="MSF_MUTABLE_SERVLET_FIELD"/>
    </Match>
    <Match>
        <!--  Reports \n in a format string; the project targets Unix and pins LF everywhere, so the
              platform-independent %n this asks for would buy nothing:  -->
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
    <Match>
        <!--  Flags every constructor that validates its arguments and throws; the
              finalizer-attack vector it guards against is obsolete since finalization
              has been deprecated for removal (JEP 421):  -->
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <!--  A test method has no caller that a narrower clause would help, so a broad `throws Exception`
              costs nothing there and spares churn each time a test calls something that throws a new
              checked type. Keep the detector active for production code, where the clause does inform
              callers. A project that additionally forbids the clause outright in tests (as this one does,
              via the custom PMD rule NoThrowsInTestClass, preferring Lombok's @SneakyThrows) simply never
              reaches this exclusion.  -->
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
        <Source name="~.*(Test|IT)\.java"/>
    </Match>
</FindBugsFilter>
