<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>airness-parent</artifactId>
    <packaging>pom</packaging>

    <name>airness-parent</name>
    <description>
        The parent a consuming project inherits. It carries the plugin configuration and the lifecycle
        bindings, so a consumer states its coordinates and its dependencies and receives the harness.

        It binds the analyzers, tests, coverage, mutation analysis, source normalization, and repository
        governance. A consumer updates the complete harness by raising one parent version.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- One finding switch for the whole harness. skipTests is the separate total bypass. -->
        <airness.enforce>true</airness.enforce>
        <skipTests>false</skipTests>

        <!--
            The phase at which each source-shaping tool APPLIES its changes. Only the applying half is a
            property. The checking half is bound to a literal phase and cannot be moved by anyone.

            That asymmetry is the point. A property naming the checking phase would be a switch a
            consumer could set to "none" in its own pom, and the build would then pass while shaping
            nothing, which is the failure this whole harness exists to make impossible. Setting one of
            these can only add work: the tool applies its changes first and the check still runs
            afterwards, so the check is what confirms the apply did its job rather than something the
            apply replaces.

            The format profile below is what sets them. Each applying execution is declared ahead of its
            checking one, so within the shared phase the apply runs first.
        -->
        <airness.rewrite.apply.phase>none</airness.rewrite.apply.phase>

        <!-- Versions, pinned here so a consumer raises one parent version rather than a dozen properties -->
        <!-- Literal by design: ${project.version} would resolve to the consuming project's version. -->
        <airness.version>1.0.0-SNAPSHOT</airness.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <rewrite-maven-plugin.version>6.45.0</rewrite-maven-plugin.version>
        <rewrite-apache.version>2.29.0</rewrite-apache.version>
        <rewrite-logging-frameworks.version>3.30.0</rewrite-logging-frameworks.version>
        <rewrite-static-analysis.version>2.40.0</rewrite-static-analysis.version>
        <rewrite-migrate-java.version>3.41.0</rewrite-migrate-java.version>
        <rewrite-testing-frameworks.version>3.43.0</rewrite-testing-frameworks.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <editorconfig-maven-plugin.version>0.2.0</editorconfig-maven-plugin.version>
        <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <min.maven.version>3.9.11</min.maven.version>
        <!--
            Where the harness unpacks what it supplies. Under the build directory rather than in the
            tree, because a copy in the tree is a copy that gets edited and then ignored, and because
            the build directory is already ignored by git and so is invisible to the tree-mutation net.
        -->
        <!-- Pinned, so the scan a build runs is the scan the next build runs. -->
        <gitleaks.image>zricethezav/gitleaks:v8.30.0</gitleaks.image>
        <qodana.image>jetbrains/qodana-jvm-community:2026.1</qodana.image>
        <pitest-maven.version>1.25.8</pitest-maven.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
        <!--
            Classes the mutation analysis leaves alone, comma-separated, each by the role it plays.
            Empty by default, for the same reason the coverage exclusions are.
        -->
        <airness.mutation.excluded.classes></airness.mutation.excluded.classes>
        <error-prone.version>2.50.0</error-prone.version>
        <nullaway.version>0.13.7</nullaway.version>
        <jspecify.version>1.0.0</jspecify.version>
        <spotbugs-annotations.version>4.9.8</spotbugs-annotations.version>
        <junit.version>6.1.2</junit.version>
        <lombok.version>1.18.46</lombok.version>
        <!--
            The package NullAway treats as annotated. Everything outside it is assumed unannotated and
            goes unchecked, so a value naming a package this project does not use turns the whole
            null-checker into a no-op that still appears in the build log. check-parameters refuses to
            let it stay unset.
        -->
        <airness.package.root>UNSET</airness.package.root>
        <!--
            Classes left out of the per-class coverage floor, comma-separated, each because of the role
            it plays rather than because covering it was inconvenient. Empty by default: a harness that
            arrived with exclusions would be teaching a project that the list is where difficulty goes.
        -->
        <airness.coverage.excluded.classes></airness.coverage.excluded.classes>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>13.9.0</checkstyle.version>
        <qulice-maven-plugin.version>0.30.1</qulice-maven-plugin.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
    </properties>

    <dependencies>
        <!--
            Inherited by every consumer, so the annotation the rule set expects is on the compile
            classpath without anyone declaring it. A rule that demands an annotation a project has to go
            and write for itself is a rule that gets worked around rather than followed.

            provided scope, because the annotation has SOURCE retention and is gone by the time the class
            file exists. Nothing needs it later, so nothing downstream should resolve it.
        -->
        <dependency>
            <groupId>eu.ciechanowiec</groupId>
            <artifactId>airness-annotations</artifactId>
            <version>${airness.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>${spotbugs-annotations.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                    <configuration>
                        <!--
                            Dependency analysis reads class files, and a SOURCE-retention annotation
                            leaves none behind. airness-annotations is therefore used by every project
                            that suppresses a rule and reported as unused by all of them. The exemption is
                            named for this one artifact rather than switched off wholesale, so a genuinely
                            unused dependency is still reported.
                        -->
                        <ignoredUnusedDeclaredDependencies>
                            <ignoredUnusedDeclaredDependency>
                                eu.ciechanowiec:airness-annotations
                            </ignoredUnusedDeclaredDependency>
                        </ignoredUnusedDeclaredDependencies>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <!--
                    Error Prone is a javac plugin rather than a Maven one: it hooks the compiler's typed
                    AST while compiling. Since JDK 16 that compiler is strongly encapsulated, so reaching
                    it needs a forked javac carrying the exports and opens below.

                    NullAway rides along as an Error Prone check. It reads airness.package.root to decide
                    what counts as annotated code, and everything outside that package is assumed
                    unannotated and left alone, which is why a wrong value there disables the checker
                    while leaving it in the log looking configured.

                    The reflective-injection annotations are excluded from the field-initialization
                    check, because a field a framework assigns is not a field the constructor forgot.
                    The list is fixed rather than a property: a project that could extend it could also
                    empty it, and an empty list reads in the log exactly like a correct one.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <fork>true</fork>
                    <compilerArgs>
                        <arg>-XDcompilePolicy=simple</arg>
                        <arg>--should-stop=ifError=FLOW</arg>
                        <arg>-Xplugin:ErrorProne -Xep:NullAway:ERROR -XepOpt:NullAway:AnnotatedPackages=${airness.package.root} -XepOpt:NullAway:ExcludedFieldAnnotations=org.apache.maven.plugins.annotations.Parameter,org.apache.maven.plugins.annotations.Component,org.junit.jupiter.api.io.TempDir,picocli.CommandLine.Option,picocli.CommandLine.Parameters,javax.inject.Inject,jakarta.inject.Inject</arg>
                        <arg>-Werror</arg>
                        <arg>-Xlint:deprecation</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>com.google.errorprone</groupId>
                            <artifactId>error_prone_core</artifactId>
                            <version>${error-prone.version}</version>
                        </path>
                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <!--
                    Coverage measured per class rather than over the module. A module-wide floor lets one
                    thoroughly covered class carry an untested one, and the arithmetic that makes that
                    work gets easier the larger the module grows, so the number stops meaning what it
                    says exactly when it matters most.

                    Both counters are held to the same floor. Instructions alone say a line ran, which a
                    single walk through a method achieves while leaving every branch in it untaken.
                -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <configuration>
                    <skip>${skipTests}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>airness-coverage-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>airness-coverage-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>airness-coverage-check</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>${airness.enforce}</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <excludes>${airness.coverage.excluded.classes}</excludes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <configuration>
                    <skip>${skipTests}</skip>
                    <fail>${airness.enforce}</fail>
                </configuration>
                <executions>
                    <execution>
                        <id>airness-enforce-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[${min.maven.version},)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>${maven.compiler.release}</version>
                                    <message>The harness targets JDK ${maven.compiler.release}</message>
                                </requireJavaVersion>
                                <!--
                                    A transitive dependency that another path down-versions is the kind of
                                    difference that shows up as a NoSuchMethodError in production and in
                                    nothing before it. Pin it explicitly instead.
                                -->
                                <requireUpperBoundDeps>
                                    <message>
                                        A transitive dependency is down-versioned by another path. Pin it
                                        explicitly rather than leaving the resolution order to decide.
                                    </message>
                                </requireUpperBoundDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    Fails on a declared dependency nothing uses, and on a used one nothing declares, so
                    the declared set stays exactly what the code needs. Non-compile scopes are left out,
                    because this reads class files and cannot see a dependency used only through
                    annotations or reflection.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!--
                        Exposes each resolved dependency path as ${groupId:artifactId:type}. Java 25
                        modernization uses that standard property form when Mockito is already present
                        and must run as a test JVM agent instead of attaching itself dynamically.
                    -->
                    <execution>
                        <id>airness-dependency-properties</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>airness-analyze-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <failOnWarning>${airness.enforce}</failOnWarning>
                            <ignoreNonCompile>true</ignoreNonCompile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    Holds every committable text file to the .editorconfig the harness owns. Binaries,
                    IDE metadata, and build output are exempt by role.
                -->
                <groupId>org.ec4j.maven</groupId>
                <artifactId>editorconfig-maven-plugin</artifactId>
                <version>${editorconfig-maven-plugin.version}</version>
                <configuration>
                    <skip>${skipTests}</skip>
                    <failOnFormatViolation>${airness.enforce}</failOnFormatViolation>
                    <failOnNoMatchingProperties>true</failOnNoMatchingProperties>
                    <excludes>
                        <exclude>**/target/**</exclude>
                        <exclude>.git/**</exclude>
                        <exclude>.idea/**</exclude>
                        <exclude>**/*.png</exclude>
                        <exclude>**/*.ttf</exclude>
                        <exclude>**/*.docx</exclude>
                        <!-- Tab-separated data: a tab is the format there, not an indentation choice. -->
                        <exclude>**/*.tsv</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>airness-editorconfig-check</id>
                        <phase>package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                    An allowlist over the licenses of everything that resolves. A dependency whose
                    license cannot be read fails alongside one whose license is not allowed, because
                    unknown and disallowed are the same answer to the question being asked.
                -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>airness-check-dependency-licenses</id>
                        <phase>package</phase>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                        <configuration>
                            <includedScopes>compile,runtime,provided,test</includedScopes>
                            <skipAddThirdParty>${skipTests}</skipAddThirdParty>
                            <failOnBlacklist>${airness.enforce}</failOnBlacklist>
                            <failOnMissing>${airness.enforce}</failOnMissing>
                            <includedLicenses>
                                <includedLicense>Apache-2.0</includedLicense>
                                <includedLicense>MIT</includedLicense>
                                <includedLicense>MIT-0</includedLicense>
                                <includedLicense>BSD-2-Clause</includedLicense>
                                <includedLicense>BSD-3-Clause</includedLicense>
                                <includedLicense>EPL-2.0</includedLicense>
                                <includedLicense>LGPL-2.1</includedLicense>
                                <includedLicense>JSON</includedLicense>
                                <includedLicense>Public Domain</includedLicense>
                            </includedLicenses>
                            <licenseMerges>
                                <licenseMerge>Apache-2.0|The Apache Software License, Version 2.0|The Apache Software License, version 2.0|The Apache License, Version 2.0|Apache License, Version 2.0|Apache License 2.0|Apache 2.0</licenseMerge>
                                <licenseMerge>MIT|The MIT License|MIT License|The MIT License (MIT)</licenseMerge>
                                <licenseMerge>BSD-2-Clause|BSD 2-Clause|BSD-2-Clause License|The 2-Clause BSD License|The BSD 2-Clause License</licenseMerge>
                                <licenseMerge>EPL-2.0|Eclipse Public License v2.0|Eclipse Public License - v 2.0|Eclipse Public License, Version 2.0</licenseMerge>
                                <licenseMerge>LGPL-2.1|GNU Lesser General Public License, Version 2.1|GNU Lesser Public License|GNU LESSER GENERAL PUBLIC LICENSE, Version 2.1</licenseMerge>
                                <licenseMerge>JSON|The JSON License</licenseMerge>
                            </licenseMerges>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                OpenRewrite, over a recipe set it discovers rather than one a project configures. The
                recipes live in META-INF/rewrite/ inside airness-config, which OpenRewrite reads off this
                plugin's own classpath, so no project carries a rewrite.yml of its own.

                Declared before the formatter and the import sorter. Under the format profile all three
                apply rather than check, and OpenRewrite's semantic edits have to land before the other
                two re-normalize layout and imports, or the formatter stops being the last word on style.
            -->
            <plugin>
                <groupId>org.openrewrite.maven</groupId>
                <artifactId>rewrite-maven-plugin</artifactId>
                <version>${rewrite-maven-plugin.version}</version>
                <configuration>
                    <rewriteSkip>${skipTests}</rewriteSkip>
                    <activeRecipes>
                        <recipe>eu.ciechanowiec.airness.Modernization</recipe>
                    </activeRecipes>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>eu.ciechanowiec</groupId>
                        <artifactId>airness-config</artifactId>
                        <version>${airness.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-apache</artifactId>
                        <version>${rewrite-apache.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-logging-frameworks</artifactId>
                        <version>${rewrite-logging-frameworks.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-migrate-java</artifactId>
                        <version>${rewrite-migrate-java.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-static-analysis</artifactId>
                        <version>${rewrite-static-analysis.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-testing-frameworks</artifactId>
                        <version>${rewrite-testing-frameworks.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <!--
                        dryRun rather than run. A recipe that would change a source file fails the build
                        and writes the patch it would have applied under target, so a green build is a
                        statement about the tree that was committed rather than about one the build
                        reshaped on its way past.
                    -->
                    <execution>
                        <id>airness-rewrite-apply</id>
                        <phase>${airness.rewrite.apply.phase}</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>airness-rewrite-verify</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>dryRun</goal>
                        </goals>
                        <configuration>
                            <failOnDryRunResults>${airness.enforce}</failOnDryRunResults>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                The governance checks are goals rather than tests, so -Dtest=OneClass cannot accidentally
                deselect them. The explicit -DskipTests contract is implemented inside every goal and is
                the one supported way to bypass both ordinary tests and the complete harness.

                The repository-wide goals run only on the top-level project, so a reactor reports each
                finding once. The per-module goals skip a module with no Java source directory, and
                refuse a module that has one and read nothing out of it.
            -->
            <plugin>
                <groupId>eu.ciechanowiec</groupId>
                <artifactId>airness-maven-plugin</artifactId>
                <version>${airness.version}</version>
                <executions>
                    <execution>
                        <id>airness-source-formatting</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>source-formatting</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>airness-preflight</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>assets-sync</goal>
                            <goal>tree-snapshot</goal>
                            <goal>check-parameters</goal>
                            <goal>assets-check</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>airness-coverage-evidence</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>coverage-evidence</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>airness-governance</id>
                        <phase>package</phase>
                        <goals>
                            <goal>typography</goal>
                            <goal>entry-files</goal>
                            <goal>comment-prose</goal>
                            <goal>javadoc-links</goal>
                            <goal>tree-verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                    <!--
                    Supplies the custom com.qulice.checkstyle.* AST checks (paired-brackets notation and
                    the other rules referenced in checkstyle.xml). The qulice plugin jar is a library of
                    check classes on this plugin's isolated classpath, not a plugin this build runs: its
                    goal is never invoked. Its bundled checkstyle is excluded so the plugin runs solely on
                    the pinned ${checkstyle.version} declared above. The standalone qulice-checkstyle
                    artifact is frozen at 0.25.2 and the checks now ship inside qulice-maven-plugin.
                    -->
                    <dependency>
                        <groupId>com.qulice</groupId>
                        <artifactId>qulice-maven-plugin</artifactId>
                        <version>${qulice-maven-plugin.version}</version>
                        <exclusions>
                            <exclusion>
                                <groupId>com.puppycrawl.tools</groupId>
                                <artifactId>checkstyle</artifactId>
                            </exclusion>
                        </exclusions>
                    </dependency>
                    <!--
                        The configuration itself, carried on this plugin's classpath so configLocation
                        below resolves as a resource. This is what replaces the consumer-local file.
                    -->
                    <dependency>
                        <groupId>eu.ciechanowiec</groupId>
                        <artifactId>airness-config</artifactId>
                        <version>${airness.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>eu/ciechanowiec/airness/static_code_analysis/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <!--
                        failsOnError covers a Checkstyle processing error; failOnViolation covers a rule
                        violation. Both read the switch, or turning it off would leave violations failing
                        the build and the switch would be a half-truth.
                    -->
                    <skip>${skipTests}</skip>
                    <failsOnError>${airness.enforce}</failsOnError>
                    <failOnViolation>${airness.enforce}</failOnViolation>
                    <violationSeverity>info</violationSeverity>
                    <linkXRef>false</linkXRef>
                    <includeResources>false</includeResources>
                    <includeTestResources>false</includeTestResources>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>eu.ciechanowiec</groupId>
                        <artifactId>airness-config</artifactId>
                        <version>${airness.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <rulesets>
                        <ruleset>eu/ciechanowiec/airness/static_code_analysis/pmd.xml</ruleset>
                    </rulesets>
                    <skip>${skipTests}</skip>
                    <failOnViolation>${airness.enforce}</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <suppressMarker>__AIRNESS_INLINE_SUPPRESSION_DISABLED__</suppressMarker>
                    <includeTests>true</includeTests>
                    <linkXRef>false</linkXRef>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>eu.ciechanowiec</groupId>
                        <artifactId>airness-config</artifactId>
                        <version>${airness.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <excludeFilterFile>eu/ciechanowiec/airness/static_code_analysis/spotbugs-exclude.xml</excludeFilterFile>
                    <skip>${skipTests}</skip>
                    <failOnError>${airness.enforce}</failOnError>
                    <includeTests>true</includeTests>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Findings remain visible, but compilation and tool failures remain fatal. -->
            <id>airness-report-only</id>
            <activation>
                <property>
                    <name>airness.enforce</name>
                    <value>false</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <testFailureIgnore>true</testFailureIgnore>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <compilerArgs combine.self="override">
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne -XepAllErrorsAsWarnings -Xep:NullAway:WARN -XepOpt:NullAway:AnnotatedPackages=${airness.package.root} -XepOpt:NullAway:ExcludedFieldAnnotations=org.apache.maven.plugins.annotations.Parameter,org.apache.maven.plugins.annotations.Component,org.junit.jupiter.api.io.TempDir,picocli.CommandLine.Option,picocli.CommandLine.Parameters,javax.inject.Inject,jakarta.inject.Inject</arg>
                                <arg>-Xlint:deprecation</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- skipTests removes compiler-side analysis as well as lifecycle-bound harness checks. -->
            <id>airness-skip</id>
            <activation>
                <property>
                    <name>skipTests</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <fork>false</fork>
                            <compilerArgs combine.self="override"/>
                            <annotationProcessorPaths combine.self="override">
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                    <version>${lombok.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!--
                A module with no production sources has nothing for the coverage agent to measure.
                Production code without tests is deliberately not skipped: coverage evidence reports it.
            -->
            <id>airness-no-production-code</id>
            <activation>
                <file>
                    <missing>src/main/java</missing>
                </file>
            </activation>
            <properties>
                <jacoco.skip>true</jacoco.skip>
            </properties>
        </profile>
        <profile>
            <!--
                Applies what the ordinary build only reports. Each source-shaping tool applies its
                changes and is then checked, in that order and in the same phase, so this profile adds
                work rather than removing any: the check still runs and now confirms the apply landed.

                It is opt-in because the alternative is a build that edits the sources it is judging.
                Once that happens, a green result says the tree was acceptable after the build changed
                it, and no one afterwards can tell that from a tree that was acceptable as committed.
            -->
            <id>format</id>
            <properties>
                <airness.rewrite.apply.phase>process-resources</airness.rewrite.apply.phase>
            </properties>
        </profile>
        <profile>
            <!--
                The slow half of the harness. What lands here is what reads more than this module: the
                whole commit history, the network, Docker, the mutation analysis, and the IntelliJ
                inspection engine. None of it belongs in the loop a developer runs a dozen times an
                hour, and all of it runs on every push.

                These are executions in a profile rather than tests carrying a tag. A tag is honoured
                only for as long as nobody overrides the excluded groups, whereas an execution that is
                not in the active profile does not exist to be re-enabled.
            -->
            <id>full</id>
            <build>
                <plugins>
                    <!--
                        The mutation analysis, declared ahead of the plugin whose mutation-baseline goal
                        reads its report. Both bind to package and Maven runs same-phase executions in
                        plugin declaration order, so declaring them the other way round would leave the
                        goal reading a report from the previous build, or none at all.

                        The parent owns this declaration so a project tunes it through properties rather
                        than carrying its own copy. What a project does own is the baseline file, which
                        describes that project's own surviving mutants and is meaningless copied.
                    -->
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest-maven.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <targetClasses>
                                <param>${airness.package.root}.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>${airness.package.root}.*</param>
                            </targetTests>
                            <excludedClasses>${airness.mutation.excluded.classes}</excludedClasses>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                        </configuration>
                        <executions>
                            <execution>
                                <id>airness-mutation-coverage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>eu.ciechanowiec</groupId>
                        <artifactId>airness-maven-plugin</artifactId>
                        <version>${airness.version}</version>
                        <executions>
                            <execution>
                                <!--
                                    Before anything else in this profile. A truncated clone disarms the
                                    two history goals below at once, and disarms them quietly: the
                                    commits that were never fetched pass by not existing.
                                -->
                                <id>airness-history-preflight</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>require-full-history</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>airness-governance-full</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>commit-history</goal>
                                    <goal>commit-typography</goal>
                                    <goal>dependency-freshness</goal>
                                    <goal>mutation-baseline</goal>
                                    <goal>scan-secrets</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>airness-qodana</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>qodana</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
