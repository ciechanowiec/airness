<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The npm package @airness/payload, governed as the TypeScript library it is. It inherits
        airness-parent-node, not airness-parent-payload: the library is no Payload application, so the Payload
        gates have nothing to judge here. The Payload stack is proven by the Payload applications of the payload
        integration domain. The relativePath is written out because the default would resolve to the aggregator
        in the directory above.
    -->
    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness-parent-node</artifactId>
        <version>1.0.10</version>
        <relativePath>../airness-parent-node/pom.xml</relativePath>
    </parent>

    <artifactId>airness-payload-node</artifactId>
    <packaging>pom</packaging>

    <name>airness-payload-node</name>
    <description>
        The Payload gates of the Airness Payload stack, published to npm as @airness/payload: the gates
        airness:node-gate runs in a Payload module, the stack defaults the node gates read, and the Payload ESLint
        configuration.
    </description>

    <properties>
        <airness.package.root>eu.ciechanowiec.airness</airness.package.root>
    </properties>

    <!--
        The @airness/node tarball this module installs is the one the reactor has just packed in airness-node. This
        dependency only orders the reactor, so that airness-node is packed before the registry below serves it.
    -->
    <dependencies>
        <dependency>
            <groupId>eu.ciechanowiec</groupId>
            <artifactId>airness-node</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                The local registry that serves @airness/node until it is published, on a port of its own: it binds a free
                port, writes the scope line into the ignored .npmrc, then the port file, and stops when Maven exits.
                The stale port file goes first and the build waits for the new one, so node-dependencies, at
                initialize, installs only once the registry answers, and two concurrent builds never share one. Every
                change to airness-node changes the tarball's integrity, which the lockfile records, so
                harness-lock-refresh below refreshes a stale lock, or one left with merge conflict markers, and then
                stops the build, which has rewritten a tracked file; the next build runs on the refreshed lock. In CI
                it refreshes nothing and fails, so a branch whose committed lock is stale cannot pass.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>harness-registry-reset</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>mkdir -p "$0" &amp;&amp; rm -f "$0/registry.port"</argument>
                                <argument>${project.build.directory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>harness-registry</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>python3</executable>
                            <async>true</async>
                            <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
                            <arguments>
                                <argument>${project.basedir}/.airness/npm-registry.py</argument>
                                <argument>--port-file</argument>
                                <argument>${project.build.directory}/registry.port</argument>
                                <argument>--npmrc</argument>
                                <argument>${project.basedir}/.npmrc</argument>
                                <argument>--scope</argument>
                                <argument>@airness</argument>
                                <argument>--fresh</argument>
                                <argument>${project.basedir}/../airness-node/target/airness-node-${project.version}.tgz</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>harness-registry-ready</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>waited=0; until [ -s "$0" ]; do [ "$waited" -ge 300 ] &amp;&amp; { echo "the local registry did not start" &gt;&amp;2; exit 1; }; sleep 0.1; waited=$((waited + 1)); done</argument>
                                <argument>${project.build.directory}/registry.port</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!--
                        Bound at initialize, where this plugin runs before node-dependencies, with the pnpm the
                        reactor's airness-maven-plugin pins, which airness-node has installed into the toolchain
                        cache of the local repository before this module builds.
                    -->
                    <execution>
                        <id>harness-lock-refresh</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>version="$(sed -n 's/^pnpm[.]version=//p' "$0")"; case "$(uname -s)" in Darwin) system=darwin ;; *) system=linux ;; esac; case "$(uname -m)" in arm64 | aarch64) architecture=arm64 ;; *) architecture=x64 ;; esac; exec python3 "$1" --refresh-with "$2/pnpm-$version-$system-$architecture/pnpm" --lockfile "$3" --fresh "$4"</argument>
                                <argument>${project.basedir}/../airness-maven-plugin/src/main/resources/eu/ciechanowiec/airness/node/toolchain.properties</argument>
                                <argument>${project.basedir}/.airness/npm-registry.py</argument>
                                <argument>${settings.localRepository}/.airness/toolchain</argument>
                                <argument>${project.basedir}/pnpm-lock.yaml</argument>
                                <argument>${project.basedir}/../airness-node/target/airness-node-${project.version}.tgz</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                The package's own build: the TypeScript compiled into dist before verify, where the gates run, and
                then packed into target as the tarball the integration fixtures install. Both run under
                -DskipTests too, so the tarball always matches the built package.
            -->
            <plugin>
                <groupId>eu.ciechanowiec</groupId>
                <artifactId>airness-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>node-build</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>node-run</goal>
                        </goals>
                        <configuration>
                            <project>.</project>
                            <script>build</script>
                        </configuration>
                    </execution>
                    <execution>
                        <id>node-pack</id>
                        <phase>test</phase>
                        <goals>
                            <goal>node-run</goal>
                        </goals>
                        <configuration>
                            <project>.</project>
                            <script>package</script>
                        </configuration>
                    </execution>
                    <!--
                        The proof that the pack is reproducible, as airness-node gives it, with the comparison script
                        of airness-node: a consumer lockfile records the integrity of the tarball it installed.
                    -->
                    <execution>
                        <id>node-repack</id>
                        <phase>test</phase>
                        <goals>
                            <goal>node-run</goal>
                        </goals>
                        <configuration>
                            <project>.</project>
                            <script>package:reproducible</script>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-npm-package</id>
                        <phase>package</phase>
                        <goals><goal>attach-artifact</goal></goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/airness-payload-${project.version}.tgz</file>
                                    <type>tgz</type>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
