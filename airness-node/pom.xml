<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The npm package @airness/node, governed as the TypeScript library it is. It inherits the node parent
        a consumer inherits, so the reactor runs the node gates on it with the plugin and parents it has just
        built. Each gate runs the airness-node binary this module builds into dist, through the package's
        own link to itself, rather than an installed release.
    -->
    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness-parent-node</artifactId>
        <version>1.0.10</version>
        <relativePath>../airness-parent-node/pom.xml</relativePath>
    </parent>

    <artifactId>airness-node</artifactId>
    <packaging>pom</packaging>

    <name>airness-node</name>
    <description>
        The JS/TS gates of the Airness node layer, published to npm as @airness/node: the gates airness:node-gate
        runs, the analyzer configurations they read, and the analyzers pinned at the versions the harness decides.
    </description>

    <properties>
        <airness.package.root>eu.ciechanowiec.airness</airness.package.root>
    </properties>

    <build>
        <plugins>
            <!--
                The package's own build: the TypeScript compiled into an emptied dist before verify, where the gates
                run that build, its own Vitest suite included, and then packed into target as the tarball a consumer
                installs, which the integration fixtures install. The files allowlist of package.json packs only the
                compiled JavaScript, its declarations and the shipped configurations. All three executions run under
                -DskipTests too, so the tarball always matches the built package.
            -->
            <plugin>
                <groupId>eu.ciechanowiec</groupId>
                <artifactId>airness-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>node-build</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>node-run</goal>
                        </goals>
                        <configuration>
                            <project>.</project>
                            <script>build</script>
                        </configuration>
                    </execution>
                    <execution>
                        <id>node-pack</id>
                        <phase>test</phase>
                        <goals>
                            <goal>node-run</goal>
                        </goals>
                        <configuration>
                            <project>.</project>
                            <script>package</script>
                        </configuration>
                    </execution>
                    <!--
                        The proof that the pack is reproducible: the package rebuilt from an emptied dist and packed
                        again into target/repack must equal the tarball above byte for byte, ship no build by-product
                        and carry every file its manifest exports. Every consumer lockfile records the integrity of
                        the tarball it installed, so a rebuild of an unchanged tree that packs other bytes would
                        invalidate those locks. A difference fails the build naming the entries that differ.
                    -->
                    <execution>
                        <id>node-repack</id>
                        <phase>test</phase>
                        <goals>
                            <goal>node-run</goal>
                        </goals>
                        <configuration>
                            <project>.</project>
                            <script>package:reproducible</script>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                The packed tarball, attached to this module's artifact as type tgz without a classifier, so
                mvn install puts it in the local repository beside the pom, at
                eu/ciechanowiec/airness-node/<version>/airness-node-<version>.tgz, where a consumer outside this
                reactor that installs @airness/node before it is on npm resolves it rather than from a sibling
                checkout. A module of this reactor that installs it, such as a stack layer's package, serves the
                tarball this module has just packed into its build directory instead. npm stays its publication
                channel: the release profile keeps the whole module, this attachment included, out of the Central
                bundle.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-npm-package</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/${project.artifactId}-${project.version}.tgz</file>
                                    <type>tgz</type>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
