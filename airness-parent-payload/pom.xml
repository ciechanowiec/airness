<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The parent a Payload CMS module inherits, a consumer-facing parent like airness-parent-spring-boot. It
        inherits the node parent, whose wiring gate holds @airness/node to the node parent's version and
        @airness/payload to this parent's. Both are the version of this release. The relativePath is written
        out because the default would resolve to the aggregator in the directory above.
    -->
    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness-parent-node</artifactId>
        <version>1.0.11</version>
        <relativePath>../airness-parent-node/pom.xml</relativePath>
    </parent>

    <artifactId>airness-parent-payload</artifactId>
    <packaging>pom</packaging>

    <name>airness-parent-payload</name>
    <description>
        The parent a Payload CMS module inherits: the node parent, plus the Payload gates the @airness/payload npm
        package ships, each run by airness:node-gate, and the Payload stack's managed files. A consumer inheriting
        it declares pom packaging and depends on the @airness/payload npm package at this parent's version.
    </description>

    <build>
        <plugins>
            <plugin>
                <groupId>eu.ciechanowiec</groupId>
                <artifactId>airness-maven-plugin</artifactId>
                <!--
                    The Payload stack's managed files and generated-file declarations, on the classpath the asset
                    catalogue and the generated-file denial read. The version is the Airness release's rather than
                    project.version, which in a consumer is the consumer's own.
                -->
                <dependencies>
                    <dependency>
                        <groupId>eu.ciechanowiec</groupId>
                        <artifactId>airness-payload-assets</artifactId>
                        <version>${airness.version}</version>
                    </dependency>
                </dependencies>
                <!--
                    One node-gate execution per Payload gate, each running the gate the @airness/payload package
                    ships. The precondition runs once the dependencies are installed, before anything else is
                    judged. The others run at post-integration-test, the last phase before verify: closing is the last
                    execution of verify, and a verify execution a child parent binds would run after it, which
                    completion-order refuses.
                -->
                <executions>
                    <execution>
                        <id>node-gate-preflight</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>node-gate</goal>
                        </goals>
                        <configuration>
                            <gate>preflight</gate>
                            <command>airness-payload gate preflight</command>
                        </configuration>
                    </execution>
                    <execution>
                        <id>node-gate-payload-blocklist</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>node-gate</goal>
                        </goals>
                        <configuration>
                            <gate>payload-blocklist</gate>
                            <command>airness-payload gate payload-blocklist</command>
                        </configuration>
                    </execution>
                    <execution>
                        <id>node-gate-payload-source-rules</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>node-gate</goal>
                        </goals>
                        <configuration>
                            <gate>payload-source-rules</gate>
                            <command>airness-payload gate payload-source-rules</command>
                        </configuration>
                    </execution>
                    <execution>
                        <id>node-gate-admin-views</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>node-gate</goal>
                        </goals>
                        <configuration>
                            <gate>admin-views</gate>
                            <command>airness-payload gate admin-views</command>
                        </configuration>
                    </execution>
                    <execution>
                        <id>node-gate-payload-environment</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>node-gate</goal>
                        </goals>
                        <configuration>
                            <gate>payload-environment</gate>
                            <command>airness-payload gate payload-environment</command>
                        </configuration>
                    </execution>
                    <execution>
                        <id>node-gate-payload-generated</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>node-gate</goal>
                        </goals>
                        <configuration>
                            <gate>payload-generated</gate>
                            <command>airness-payload gate payload-generated</command>
                        </configuration>
                    </execution>
                    <execution>
                        <id>node-gate-payload-defaults</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>node-gate</goal>
                        </goals>
                        <configuration>
                            <gate>payload-defaults</gate>
                            <command>airness-payload gate payload-defaults</command>
                        </configuration>
                    </execution>
                    <execution>
                        <id>node-gate-payload-migrations</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>node-gate</goal>
                        </goals>
                        <configuration>
                            <gate>payload-migrations</gate>
                            <command>airness-payload gate payload-migrations</command>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
