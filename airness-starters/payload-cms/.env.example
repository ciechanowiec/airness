# Copy to .env before the first `pnpm run up`, and choose every secret in the copy. They are left empty
# here, so a copy nobody chose them in stops the services and the application at startup rather than running
# them under a value anybody reading this file knows. The rest suits a machine running the application for
# itself; a deployment supplies its own values, and .env is never committed.

# The database compose.yaml starts, and the account the application signs in to it with.
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=

# Signs the Payload session tokens. The application refuses to start without it.
PAYLOAD_SECRET=

# How many reverse proxies in front of the server append the address they received each request from to
# X-Forwarded-For. The limit on sign-in and password-reset attempts identifies a client by the entry the
# outermost of them wrote. A whole number of at least 1.
TRUSTED_PROXY_COUNT=1

# The S3-compatible bucket uploads are stored in. compose.yaml starts RustFS with these credentials and
# creates the bucket; the region is the one requests are signed for, which RustFS accepts as it is.
S3_BUCKET=starter
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=starter
S3_SECRET_ACCESS_KEY=

# The application reads these, and scripts/local.ts sets each of them, with the ports it chooses free on this
# machine, for `pnpm run up`, `pnpm dev` and the other scripts that reach the services: leave them empty here.
# A deployment supplies its own. NEXT_PUBLIC_SERVER_URL is the public origin of the site, the only CORS and CSRF
# origin, which a production server refuses to start without.
DATABASE_URL=
S3_ENDPOINT=
NEXT_PUBLIC_SERVER_URL=
APP_PORT=
DB_PORT=
S3_PORT=

# The password of the local administrator `pnpm seed` creates (scripts/seed.ts); set SEED_ADMIN_EMAIL or
# SEED_ADMIN_NAME only to override its identity.
SEED_ADMIN_PASSWORD=
