# Starts the database, the object storage and the application together on one machine. Build the standalone
# server first with `mvn clean verify`, because the image copies what that produced rather than building the
# project. Copy .env.example to .env and choose the values, then start it with `pnpm run up`.
#
# Every port is published on the loopback interface, on the port scripts/local.ts chooses free on this machine, so
# another checkout of the project, or another project, runs beside it. `pnpm dev` starts the database and the
# storage alone through the same script and runs the development server on the host against them.
services:
  db:
    image: postgres:18-alpine
    environment:
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    # The application waits for this to answer rather than for the container to exist, because
    # PostgreSQL accepts connections only once its first start has initialised the volume.
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 20
    volumes:
      - database:/var/lib/postgresql
    ports:
      - "127.0.0.1:${DB_PORT}:5432"
  # S3-compatible storage for uploads. The health check creates the upload bucket, so it answers once RustFS
  # accepts requests and the bucket the application writes to exists.
  objects:
    image: rustfs/rustfs:1.0.5
    command: ["/data"]
    environment:
      RUSTFS_ACCESS_KEY: ${S3_ACCESS_KEY_ID}
      RUSTFS_SECRET_KEY: ${S3_SECRET_ACCESS_KEY}
      UPLOAD_BUCKET: ${S3_BUCKET}
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          RC_CONFIG_DIR=/tmp/rc RC_HOST_local="http://$$RUSTFS_ACCESS_KEY:$$RUSTFS_SECRET_KEY@127.0.0.1:9000"
          rc bucket create "local/$$UPLOAD_BUCKET" --ignore-existing
      interval: 5s
      timeout: 5s
      retries: 20
    volumes:
      - objects:/data
    ports:
      - "127.0.0.1:${S3_PORT}:9000"
  app:
    build: .
    depends_on:
      db:
        condition: service_healthy
      objects:
        condition: service_healthy
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
      PAYLOAD_SECRET: ${PAYLOAD_SECRET}
      # The origin the application accepts authenticated requests from, which is the one it is published on.
      NEXT_PUBLIC_SERVER_URL: http://localhost:${APP_PORT}
      TRUSTED_PROXY_COUNT: ${TRUSTED_PROXY_COUNT}
      S3_ENDPOINT: http://objects:9000
      S3_BUCKET: ${S3_BUCKET}
      S3_REGION: ${S3_REGION}
      S3_ACCESS_KEY_ID: ${S3_ACCESS_KEY_ID}
      S3_SECRET_ACCESS_KEY: ${S3_SECRET_ACCESS_KEY}
    # Published on the loopback interface alone, because this file runs the application for the machine it
    # is on. A deployment that serves others puts its own proxy in front of it.
    ports:
      - "127.0.0.1:${APP_PORT}:3000"
volumes:
  database:
  objects:
