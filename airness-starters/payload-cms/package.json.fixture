{
  "name": "starter",
  "version": "1.0.0",
  "private": true,
  "license": "@LICENSE@",
  "description": "Starter, a Payload CMS application on Next.js, PostgreSQL and S3-compatible storage",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/build.ts",
    "up": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/local.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/local.ts next dev",
    "devsafe": "rm -rf .next && pnpm run dev",
    "storybook": "storybook dev --port 6006",
    "start": "pnpm run migrate && cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--no-deprecation next start",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/local.ts payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/local.ts pnpm run seed:direct",
    "seed:direct": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "seed:content": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-content.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/local.ts payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/local.ts payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/local.ts payload generate:importmap",
    "format": "airness-node format",
    "with:services": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/with-services.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/live-preview-react": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "cross-env": "10.1.0",
    "dotenv": "18.0.8",
    "graphql": "16.14.2",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "payload": "3.92.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@airness/node": "@AIRNESS_VERSION@",
    "@airness/payload": "@AIRNESS_VERSION@",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@playwright/test": "1.64.1",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "daisyui": "5.7.50",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26"
  },
  "airness": {
    "coverageExclude": [
      {
        "pattern": "scripts/**",
        "reason": "operational scripts that provision services for the harness or seed a database, driven by the harness rather than imported"
      },
      {
        "pattern": "src/components/live-preview-refresh.tsx",
        "reason": "a client component that renders only inside the Next.js App Router, whose router it refreshes; the end-to-end preview spec drives it through a real save event in a real browser"
      }
    ],
    "generatedArtefacts": [
      {
        "pattern": "src/migrations/**",
        "reason": "Payload writes each migration and its schema snapshot from the config with migrate:create; the files are frozen once applied, so they are read and applied rather than edited, and reformatting or refactoring one would change a migration that has already run elsewhere"
      }
    ],
    "vulnerabilityAllowlist": [
      {
        "package": "glob",
        "advisory": "GHSA-3g3m-2fjr-6pw4",
        "reason": "glob 13.0.7 reaches the project only through @joshwooding/vite-plugin-react-docgen-typescript, which @storybook/react-vite loads into the Storybook development server to read the project's own component files. It never runs in the application or its image, and the advisory needs a caller that cancels a walk with an AbortSignal and relies on it stopping, which the plugin does not do.",
        "mitigation": "Storybook is a development dependency, served only on a developer's loopback port and by the Extended browser sweep. Remove this entry once @storybook/react-vite allows @joshwooding/vite-plugin-react-docgen-typescript 0.9, which replaces glob with tinyglobby, or a glob release of 14.0.2 or later.",
        "addedOn": "2026-11-15"
      },
      {
        "package": "minimatch",
        "advisory": "GHSA-g3hv-75wg-m249",
        "reason": "minimatch 10.2.6 reaches the project only through glob 13.0.7 inside the Storybook development server's docgen plugin, which matches the fixed story and component patterns the project's own Storybook configuration names. No pattern comes from a request or from content, so the amplified pattern the advisory needs is never built.",
        "mitigation": "Storybook is a development dependency and never runs in the application or its image. Remove this entry together with the glob entry, once @storybook/react-vite allows a docgen plugin without glob 13.",
        "addedOn": "2026-11-15"
      }
    ],
    "testWrapper": [
      "pnpm",
      "run",
      "with:services",
      "--"
    ],
    "serverUrlVariables": [
      "NEXT_PUBLIC_SERVER_URL"
    ],
    "auxiliaryServers": [
      {
        "command": "pnpm exec storybook dev --port $PORT --ci --no-open",
        "url": "http://localhost:6006"
      }
    ]
  },
  "airnessPayload": {
    "publicAccess": [
      {
        "entity": "posts",
        "operation": "read",
        "reason": "the site publishes its posts to every visitor; the read rule hands a stranger only published posts, so a draft never reaches one, and the version history stays with editors",
        "fields": [
          "title",
          "excerpt",
          "cover",
          "content",
          "slug",
          "category",
          "publishedAt",
          "featured",
          "updatedAt",
          "createdAt",
          "_status"
        ]
      },
      {
        "entity": "categories",
        "operation": "read",
        "reason": "the categories are the public site's topics, which its navigation and category pages show to every visitor",
        "fields": [
          "title",
          "slug",
          "description",
          "updatedAt",
          "createdAt"
        ]
      },
      {
        "entity": "site-settings",
        "operation": "read",
        "reason": "the site settings hold the tagline, description, navigation and footer note every public page shows",
        "fields": [
          "tagline",
          "description",
          "navigation",
          "footerNote",
          "updatedAt",
          "createdAt"
        ]
      },
      {
        "entity": "media",
        "operation": "read",
        "reason": "uploaded images are the site's own assets, served to every visitor; _objectKey, which the S3 adapter adds, is a random folder segment of the object in the private upload bucket, which only Payload's own file route reads, so knowing it reaches nothing",
        "fields": [
          "alt",
          "updatedAt",
          "createdAt",
          "url",
          "thumbnailURL",
          "filename",
          "mimeType",
          "filesize",
          "width",
          "height",
          "focalX",
          "focalY",
          "_objectKey"
        ]
      }
    ],
    "analysisEnv": {
      "S3_ENDPOINT": "http://127.0.0.1:9000",
      "S3_BUCKET": "starter-static-analysis",
      "S3_ACCESS_KEY_ID": "static-analysis-placeholder",
      "S3_SECRET_ACCESS_KEY": "static-analysis-placeholder",
      "NEXT_PUBLIC_SERVER_URL": "http://localhost:3000"
    }
  }
}
