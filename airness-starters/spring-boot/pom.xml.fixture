<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness-parent-spring-boot</artifactId>
        <version>@AIRNESS_VERSION@</version>
        <relativePath/>
    </parent>

    <groupId>@GROUP_ID@</groupId>
    <artifactId>@ARTIFACT_ID@</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <!--
            The module is its own frontend tooling project: package.json sits beside this file, its
            source roots hold the stylesheet and the script the pages load, and its serve script
            launches the archive this build packages for the browser sweep. Node builds and checks
            the frontend; the application itself runs on Java alone.
        -->
        <airness.node.projects>.</airness.node.projects>
        <airness.package.root>@PACKAGE@</airness.package.root>
    </properties>

    <dependencies>
        <!--
            Declared because this code compiles against them by name, even though each one also
            arrives through a starter. The dependency analysis reads what the class files reference
            rather than what the starters happen to carry.
        -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <!--
            The servlet API, which the language switch compiles against to write its cookie. Spring
            Boot ships that API inside the embedded server rather than as an artifact of its own, so
            this is the one artifact that owns those classes. The annotations the server carries are
            excluded the way the Tomcat starter excludes them, because jakarta.annotation-api already
            owns every class in that jar.
        -->
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <scope>compile</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.tomcat</groupId>
                    <artifactId>tomcat-annotations-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
            Flyway owns the schema, so nothing here compiles against the dialect module or the driver,
            and both are resolved at runtime alone.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>compile</scope>
        </dependency>
        <!--
            The starter rather than flyway-core, because Spring Boot moved auto-configuration into a
            module per technology: flyway-core alone puts the library on the classpath and leaves the
            migrations unread.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-web</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            The stylesheet and the script the frontend build writes under target/frontend are served
            beside the authored resources, so nothing generated is ever written into a tracked
            directory. The licenses of the shipped packages travel in the JAR under META-INF, which
            the application never serves.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/frontend</directory>
                <targetPath>static</targetPath>
                <excludes>
                    <exclude>licenses/**</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>${project.build.directory}/frontend</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>licenses/**</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- @SNAPSHOT_ONLY_BEGIN@ -->
            <!--
                A SNAPSHOT harness package is never published, so it comes from the installed, versioned
                Maven artifact. The loopback registry is process-local, writes only the ignored .npmrc,
                refuses a lockfile whose recorded integrity the installed package no longer matches, and
                stops with Maven. A released harness package installs from the public registry instead.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>harness-registry-reset</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>set -eu; mkdir -p "$0"; rm -f "$0/registry.port"; test -s "$1" || { echo 'Install the local Airness artifacts before verification' &gt;&amp;2; exit 1; }</argument>
                                <argument>${project.build.directory}</argument>
                                <argument>${settings.localRepository}/eu/ciechanowiec/airness-node/${project.parent.version}/airness-node-${project.parent.version}.tgz</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>harness-registry</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>python3</executable>
                            <async>true</async>
                            <asyncDestroyOnShutdown>true</asyncDestroyOnShutdown>
                            <arguments>
                                <argument>${project.basedir}/.airness/npm-registry.py</argument>
                                <argument>--port-file</argument>
                                <argument>${project.build.directory}/registry.port</argument>
                                <argument>--npmrc</argument>
                                <argument>${project.basedir}/.npmrc</argument>
                                <argument>--scope</argument>
                                <argument>@airness</argument>
                                <argument>--lockfile</argument>
                                <argument>${project.basedir}/pnpm-lock.yaml</argument>
                                <argument>--fresh</argument>
                                <argument>${settings.localRepository}/eu/ciechanowiec/airness-node/${project.parent.version}/airness-node-${project.parent.version}.tgz</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>harness-registry-ready</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>waited=0; until [ -s "$0" ]; do [ "$waited" -ge 300 ] &amp;&amp; { echo 'The local registry did not start' &gt;&amp;2; exit 1; }; sleep 0.1; waited=$((waited + 1)); done</argument>
                                <argument>${project.build.directory}/registry.port</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- @SNAPSHOT_ONLY_END@ -->
            <!--
                Builds the stylesheet with Tailwind and daisyUI and bundles htmx with the page script,
                all from their npm releases, into target/frontend, which the resources above serve.
            -->
            <plugin>
                <groupId>eu.ciechanowiec</groupId>
                <artifactId>airness-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>frontend-assets</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>node-run</goal>
                        </goals>
                        <configuration>
                            <project>.</project>
                            <script>build</script>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage-application</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
