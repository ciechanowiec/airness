{
  "extends": "@airness/node/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/main/frontend/*"],
      "@scripts/*": ["./scripts/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
  "exclude": ["node_modules", "dist", "target"]
}
