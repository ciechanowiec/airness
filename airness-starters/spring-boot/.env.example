# Copy to .env before the first `pnpm run up`, and choose both passwords in the copy. They are left
# empty here, so a copy nobody chose them in stops the database and the application at startup rather than
# running them under a password anybody reading this file knows. The rest suits a machine running the
# application for itself; a deployment supplies its own values, and .env is never committed.
APP_DATABASE_NAME=starter
APP_DATABASE_USERNAME=starter
APP_DATABASE_PASSWORD=
APP_ADMINISTRATOR_EMAIL=administrator@starter.local
APP_ADMINISTRATOR_PASSWORD=
# The first start writes a team of demonstration people and their tasks. Each of them signs in with
# the administrator's password, at an address in the administrator's domain. Set false for an empty start.
APP_DEMO_DATA=true
# The loopback port the application is published on. `pnpm run up` chooses a free one each time it starts the
# application, so leave it empty here.
APP_PORT=
# The bucket every attached file is written into, and the key pair the application and the renderer sign their
# requests to it with. Choose both halves of the pair in the copy; RustFS refuses a secret shorter than eight
# characters.
APP_STORAGE_BUCKET=starter
APP_STORAGE_ACCESS_KEY=
APP_STORAGE_SECRET_KEY=
# The key and salt the renderer's addresses are signed with, each an even number of hexadecimal digits, such as
# what `openssl rand -hex 32` prints.
APP_IMAGES_KEY=
APP_IMAGES_SALT=
