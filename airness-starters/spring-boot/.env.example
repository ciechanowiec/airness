# Copy to .env before the first `docker compose up`, and choose both passwords in the copy. They are left
# empty here, so a copy nobody chose them in stops the database and the application at startup rather than
# running them under a password anybody reading this file knows. The rest suits a machine running the
# application for itself; a deployment supplies its own values, and .env is never committed.
APP_DATABASE_NAME=starter
APP_DATABASE_USERNAME=starter
APP_DATABASE_PASSWORD=
APP_ADMINISTRATOR_EMAIL=administrator@starter.local
APP_ADMINISTRATOR_PASSWORD=
