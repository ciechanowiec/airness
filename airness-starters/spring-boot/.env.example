# Copy to .env before the first `docker compose up`. The values are for a machine running the
# application for itself; a deployment supplies its own, and .env is never committed.
APP_DATABASE_NAME=starter
APP_DATABASE_USERNAME=starter
APP_DATABASE_PASSWORD=choose-a-database-password
APP_ADMINISTRATOR_EMAIL=administrator@starter.local
APP_ADMINISTRATOR_PASSWORD=choose-a-long-password
