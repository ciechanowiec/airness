<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../airness-parent/pom.xml</relativePath>
    </parent>

    <artifactId>airness-it</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>airness-it</name>
    <description>
        The harness seen from a consumer's side of it. This module inherits airness-parent the way a real
        project does and carries no analysis configuration of its own, so a finding it reports came off
        the plugin classpath and nowhere else.

        It is deliberately not a module of the airness build. A consumer inherits the parent rather than
        being built by it, and building this on its own is what makes it a test of inheritance rather
        than of aggregation. Run 'mvn clean package' here once the parent and the configuration jar are
        installed. A build that fails is the expected outcome: the sources violate rules on purpose, and
        the findings are the evidence the configuration resolved.
    </description>

    <properties>
        <airness.group.root>eu\.ciechanowiec</airness.group.root>
        <airness.package.root>eu.ciechanowiec.airness.it</airness.package.root>

        <!--
            This consumer sits inside the airness working tree, so the repository-wide goals read that
            tree rather than a tree of its own. That is the honest arrangement: those goals are rooted at
            the repository by design, and pretending otherwise would test something no consumer does.

            airness ships no instruction file and no entry file, and NONE is how a project says so. An
            empty value would be the same words in the build log as a project with three correct ones,
            which is the reading these sentinels exist to prevent.
        -->
        <airness.instruction.file>NONE</airness.instruction.file>
        <airness.entry.files>NONE</airness.entry.files>
        <airness.docs>NONE</airness.docs>

        <!--
            A linter's own style library contains by nature the glyphs it detects, and a vendored theme
            carries somebody else's typography. Both are named, and a name that stops excluding anything
            is itself reported, so this list cannot outlive the directories it points at.
        -->
        <airness.typography.excludes>.vale/,docinfo</airness.typography.excludes>
    </properties>
</project>
