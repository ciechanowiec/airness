<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../airness-parent/pom.xml</relativePath>
    </parent>

    <artifactId>airness-it</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>airness-it</name>
    <description>
        The harness seen from a consumer's side of it. This module inherits airness-parent the way a real
        project does and carries no analysis configuration of its own, so a finding it reports came off
        the plugin classpath and nowhere else.

        It is deliberately not a module of the airness build. A consumer inherits the parent rather than
        being built by it, and building this on its own is what makes it a test of inheritance rather
        than of aggregation. Run 'mvn clean package' here once the parent and the configuration jar are
        installed. A build that fails is the expected outcome: the sources violate rules on purpose, and
        the findings are the evidence the configuration resolved.
    </description>

    <properties>
        <airness.group.root>eu\.ciechanowiec</airness.group.root>
        <airness.package.root>eu.ciechanowiec.airness.it</airness.package.root>

        <!--
            This consumer sits inside the airness working tree, so the repository-wide goals read that
            tree rather than a tree of its own. That is the honest arrangement: those goals are rooted at
            the repository by design, and pretending otherwise would test something no consumer does.

            airness ships no instruction file and no entry file, and NONE is how a project says so. An
            empty value would be the same words in the build log as a project with three correct ones,
            which is the reading these sentinels exist to prevent.
        -->
        <airness.instruction.file>NONE</airness.instruction.file>
        <airness.entry.files>NONE</airness.entry.files>
        <airness.docs>NONE</airness.docs>

        <!--
            A linter's own style library contains by nature the glyphs it detects, and a vendored theme
            carries somebody else's typography. Both are named, and a name that stops excluding anything
            is itself reported, so this list cannot outlive the directories it points at.
        -->
        <airness.typography.excludes>.vale/,docinfo</airness.typography.excludes>
        <build-helper-maven-plugin.version>3.6.1</build-helper-maven-plugin.version>
    </properties>

    <dependencies>
        <!--
            One test, so this module has test sources at all. Without them the coverage floor deactivates
            on structure and would never be exercised from a consumer's side, which is the same gap the
            floor itself exists to close.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>6.1.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>6.1.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <!--
                Adds the Error Prone fixture to the sources. A finding from it is a compile error rather
                than a report, so a fixture kept under src/main/java would end every build in this module
                before the case under test reached anything.

                It gets a source root of its own rather than sharing one with the null-checker fixture,
                because javac stops after the first file that fails and only that file's finding is
                reported. Two fixtures in one root would mean one case passing and the other reporting
                nothing, for a reason that has nothing to do with the check it is about.
            -->
            <id>errorprone-fixture</id>
            <activation>
                <property>
                    <name>airness.it.errorprone</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${build-helper-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>add-errorprone-fixture</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/compiler-checks/errorprone/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- The null-checker fixture, kept apart from the one above for the reason given there. -->
            <id>nullaway-fixture</id>
            <activation>
                <property>
                    <name>airness.it.nullaway</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${build-helper-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>add-nullaway-fixture</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/compiler-checks/nullaway/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
