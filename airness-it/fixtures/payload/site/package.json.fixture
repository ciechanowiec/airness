{
  "name": "payload-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "graphql": "16.14.2",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@airness/node": "@AIRNESS_VERSION@",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@airness/payload": "@AIRNESS_VERSION@",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  },
  "airness": {
    "coverageExclude": [
      {
        "pattern": "src/migrations/**",
        "reason": "the recorded schema migrations, which payload migrate applies against a database"
      }
    ]
  },
  "airnessPayload": {
    "publicAccess": [
      {
        "entity": "posts",
        "operation": "read",
        "fields": [
          "title",
          "createdAt",
          "updatedAt"
        ],
        "reason": "the fixture publishes blog titles and publication timestamps to anonymous readers"
      }
    ]
  }
}
