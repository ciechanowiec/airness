<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness-parent-payload</artifactId>
        <version>@AIRNESS_VERSION@</version>
    </parent>

    <groupId>org.sample</groupId>
    <artifactId>payload-site</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>payload-site</name>
    <description>The payload-site fixture of the Airness integration suite.</description>
    <url>https://git.example.invalid/payload-site</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>LicenseRef-Proprietary</name>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Sample Organization</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://git.example.invalid/payload-site.git</connection>
        <developerConnection>scm:git:https://git.example.invalid/payload-site.git</developerConnection>
        <url>https://git.example.invalid/payload-site</url>
    </scm>

    <properties>
        <airness.package.root>org.sample</airness.package.root>
    </properties>
</project>
