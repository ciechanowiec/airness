{
  "name": "fixture-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs ../../../target/classes/static",
    "postinstall": "node -e \"require('node:fs').writeFileSync('root-postinstall-ran', '')\"",
    "prepare": "node -e \"require('node:fs').writeFileSync('root-prepare-ran', '')\""
  },
  "devDependencies": {
    "@airness/fixture-approved": "1.0.0",
    "@airness/fixture-denied": "1.0.0",
    "@airness/node": "1.0.9-SNAPSHOT",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5"
  },
  "airness": {
    "javascriptAllowlist": [
      {
        "pattern": "^build\\.mjs$",
        "reason": "the build step node runs directly, with no compiler before it",
        "runtime": "node"
      }
    ]
  }
}
