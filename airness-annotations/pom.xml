<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        This module inherits the aggregator rather than airness-parent, and it is the one module that
        could not do otherwise. airness-parent declares a dependency on this artifact so every consumer
        receives it without asking, and a module cannot both be depended on by its own parent and
        inherit it: that is a cycle Maven has no way to order. The rest of the build inherits the
        aggregator too, for the ordinary reason that a plugin cannot be used in the reactor that builds
        it, but here it is a requirement rather than a convention.
    -->
    <parent>
        <groupId>eu.ciechanowiec</groupId>
        <artifactId>airness</artifactId>
        <version>1.0.6</version>
    </parent>

    <artifactId>airness-annotations</artifactId>
    <packaging>jar</packaging>

    <name>airness-annotations</name>
    <description>
        The annotation the rule set expects to find in a consumer's source. This is the only Airness
        artifact that reaches a consuming project's compile classpath, which is why it is an artifact of
        its own rather than a package inside airness-config: folding it in would put the analyzer
        configurations on that classpath as well, to no purpose.

        It carries no dependencies and no runtime cost. The annotation has SOURCE retention, so it does
        not survive compilation into the consumer's artifact.
    </description>
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Airness answers to the dependency rules it ships. The rules themselves live in the root
                pluginManagement, so this execution names only the goal and the phase.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-enforce-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                The modernization recipes Airness ships, run against Airness's own sources. dryRun only:
                the apply half is the format command's job and never a verification's.
            -->
            <plugin>
                <groupId>org.openrewrite.maven</groupId>
                <artifactId>rewrite-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-rewrite-verify</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>dryRunNoFork</goal>
                        </goals>
                        <configuration>
                            <failOnDryRunResults>${airness.enforce}</failOnDryRunResults>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                This module has production Java, so it answers to the analyzers and the coverage floor the
                harness holds every other module to. It could not before: airness-config supplies the rule
                sets on an isolated plugin classpath, and this module used to be built before it.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-pmd</id>
                        <phase>package</phase>
                        <goals>
                            <goal>check</goal>
                            <goal>cpd-check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-spotbugs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-coverage-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>airness-self-coverage-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>airness-self-coverage-check</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                The unused and undeclared dependency report, and the licence allowlist, both read the
                module's own resolved graph, so each module runs them for itself. The configuration is in
                the root pluginManagement, mirroring what airness-parent binds for a consumer.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-analyze-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-check-dependency-licenses</id>
                        <phase>package</phase>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Extended verification for Airness, exactly as it is for a consumer: the phase property is
                'none' by default and 'package' under the extended profile.
            -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <executions>
                    <execution>
                        <id>airness-self-known-vulnerabilities</id>
                        <phase>${airness.self.vulnerabilities.phase}</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
